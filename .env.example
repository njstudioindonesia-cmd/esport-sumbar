# ==============================================================================
# ESPORT SUMBAR - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env (untuk lokal) atau tambahkan ke Vercel Environment Variables
# ==============================================================================

# 1. SERVER CONFIGURATION
PORT=3000
NODE_ENV=production

# 2. SUPABASE CREDENTIALS (Dapatkan dari Supabase Project Settings -> API)
# Project URL: https://[your-project-id].supabase.co
SUPABASE_URL=

# Supabase Anon Public Key (Aman untuk frontend / read-only public)
SUPABASE_ANON_KEY=

# Supabase Service Role Key (Wajib untuk backend bypass RLS pada antrean verifikasi & admin)
SUPABASE_SERVICE_ROLE_KEY=

# 3. JWT AUTH SECRET (Optional - fallback token generator)
JWT_SECRET=esport_sumbar_secure_secret_token_2026_xyz
