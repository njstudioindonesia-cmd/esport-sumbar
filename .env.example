# ==============================================================================
# ESPORT SUMBAR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esport_sumbar?schema=public

# Microservices Specific Database URLs
DATABASE_IDENTITY_URL=postgresql://postgres:postgres@localhost:5432/identity_db?schema=public
DATABASE_NEWS_URL=postgresql://postgres:postgres@localhost:5432/news_db?schema=public
DATABASE_COMMUNITY_URL=postgresql://postgres:postgres@localhost:5432/community_db?schema=public
DATABASE_EVENT_URL=postgresql://postgres:postgres@localhost:5432/event_db?schema=public
DATABASE_BRACKET_URL=postgresql://postgres:postgres@localhost:5432/bracket_db?schema=public
DATABASE_MEDIA_URL=postgresql://postgres:postgres@localhost:5432/media_db?schema=public
DATABASE_NOTIFICATION_URL=postgresql://postgres:postgres@localhost:5432/notification_db?schema=public
DATABASE_AI_URL=postgresql://postgres:postgres@localhost:5432/ai_db?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# NATS JetStream
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# MinIO / S3 Storage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=supersecret123
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=esport-sumbar-assets
S3_ACCESS_KEY=admin
S3_SECRET_KEY=supersecret123
S3_REGION=us-east-1

# JWT & 2FA Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TOTP_ENCRYPTION_KEY=sumbar_totp_aes_encryption_secret_2026

# Meta Instagram Graph API (@esportsumbar)
IG_APP_ID=
IG_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_WEBHOOK_VERIFY_TOKEN=sumbar_ig_webhook_verify_secure_2026
IG_PUBLISH_MODE=REVIEW

# Anthropic Claude API (ai-service)
ANTHROPIC_API_KEY=sk-ant-api03-placeholder-key

# Internal Gateway / Microservices / Portals Ports
GATEWAY_PORT=4000
IDENTITY_SERVICE_PORT=4001
NEWS_SERVICE_PORT=4002
NEWS_INGESTOR_PORT=4003
COMMUNITY_SERVICE_PORT=4004
EVENT_SERVICE_PORT=4005
MEDIA_SERVICE_PORT=4006
BRACKET_SERVICE_PORT=4007
AI_SERVICE_PORT=4008
NOTIFICATION_SERVICE_PORT=4009
WEB_PORT=3000
EO_PORT=3001
ADMIN_PORT=3002

