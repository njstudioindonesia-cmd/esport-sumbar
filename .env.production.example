# ==============================================================================
# ESPORT SUMBAR - Production Environment Variables Example
# ==============================================================================

# Core Infrastructure
NODE_ENV=production
POSTGRES_USER=esport_admin
POSTGRES_PASSWORD=generate_a_very_strong_password_here_123!
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=esport_minio_admin
MINIO_ROOT_PASSWORD=generate_minio_secure_password_here_456!
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# Auth & Security Secrets
JWT_SECRET=generate_random_64_byte_jwt_access_secret_sumbar_2026
JWT_REFRESH_SECRET=generate_random_64_byte_jwt_refresh_secret_sumbar_2026
HMAC_SIGNING_SECRET=generate_random_64_byte_hmac_sha256_signing_secret_2026

# External AI Provider (Anthropic Claude 3.5 Sonnet / Mock)
ANTHROPIC_API_KEY=sk-ant-api03-...
DEFAULT_LLM_PROVIDER=claude

# Frontend Public API URL
NEXT_PUBLIC_API_URL=/api
