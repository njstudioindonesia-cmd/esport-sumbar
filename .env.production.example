# ==============================================================================
# ESPORT SUMBAR v2 - Production Environment Variables Template
# Copy to `.env` on production server (set permission: chmod 600 .env)
# NEVER commit real production secrets into Git!
# ==============================================================================

# --- Node Environment ---
NODE_ENV=production

# --- Domain & Caddy Reverse Proxy Configuration ---
ACME_EMAIL=ops@esportsumbar.id
PUBLIC_DOMAIN=esportsumbar.id
EO_DOMAIN=eo.esportsumbar.id
ADMIN_DOMAIN=admin.esportsumbar.id
API_DOMAIN=api.esportsumbar.id

# --- Core Database & Caching ---
POSTGRES_USER=esport_admin
POSTGRES_PASSWORD=generate_a_very_strong_password_here_123!
REDIS_PASSWORD=generate_a_strong_redis_auth_password_here_2026!

# --- Object Storage (MinIO / S3) ---
MINIO_ROOT_USER=esport_minio_admin
MINIO_ROOT_PASSWORD=generate_minio_secure_password_here_456!

# --- Security & JWT Cryptographic Secrets ---
# Generate using: openssl rand -base64 48
JWT_SECRET=generate_random_64_byte_jwt_access_secret_sumbar_2026
JWT_REFRESH_SECRET=generate_random_64_byte_jwt_refresh_secret_sumbar_2026
HMAC_SIGNING_SECRET=generate_random_64_byte_hmac_sha256_signing_secret_2026
TOTP_ENCRYPTION_KEY=generate_random_32_byte_aes_encryption_key_2026

# --- Meta Instagram Graph API Integration (@esportsumbar) ---
IG_APP_ID=1234567890123456
IG_APP_SECRET=generate_from_meta_developer_app_dashboard
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=long_lived_user_access_token_60_days
IG_WEBHOOK_VERIFY_TOKEN=sumbar_ig_webhook_verify_secure_2026
IG_PUBLISH_MODE=REVIEW

# --- AI Engine (Claude 3.5 Sonnet / OpenAI) ---
ANTHROPIC_API_KEY=sk-ant-api03-production-key-here
OPENAI_API_KEY=sk-proj-production-key-here
DEFAULT_LLM_PROVIDER=claude

# --- Email Notifications (Resend / AWS SES / Postmark) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here

# --- Backups & Monitoring Alerts ---
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
BACKUP_S3_BUCKET=esport-sumbar-backups-sg

# --- Frontend Next.js Public URLs ---
NEXT_PUBLIC_API_URL=/api
